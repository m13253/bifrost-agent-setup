{
    "image": "mcr.microsoft.com/devcontainers/python",
    "customizations": {
        "vscode": {
            "extensions": [
                "astral-sh.ty",
                "charliermarsh.ruff",
                "ms-python.vscode-python-envs",
                "tamasfe.even-better-toml"
            ]
        }
    },
    "containerEnv": {
        "UV_LINK_MODE": "copy"
    },
    "onCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh",
    "updateContentCommand": "uv sync",
    "securityOpt": [
        // Fixes VS Code terminal sandbox & Claude Code sandbox
        // https://github.com/containers/bubblewrap/issues/505#issuecomment-5708882071
        // These two parameters lowers a rootful container’s security barriers, so please only use with a rootless container engine (rootless Docker or rootless Podman).
        "seccomp=unconfined",
        "systempaths=unconfined"
    ]
}
